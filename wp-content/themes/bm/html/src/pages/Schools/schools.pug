extends ../../_core/layouts/layouts-default

append vars
    -bodyClass = "page-template-schools is-transparent"
    -typeMenu = ""

block container
    
    section.rt-school__banner
                .rt-school__banner--head
                    .container
                        .rt-block__heading
                            .rt-title Khám phá các trường Đại học Top 1% thế giới
                            .rt-title__desc Xem danh sách toàn bộ các trường Đại học hàng đầu
                .rt-school__banner--body
                    .container
                        form.rt-school__banner--form(action="./schools.html" method="post")
                                .rt-school__banner--form__fields
                                    .rt-school__banner--form__field.dropdown
                                        button.btn.dropdown-toggle(type="button" data-bs-toggle="dropdown" data-label="Chọn quốc gia") Chọn quốc gia
                                        .dropdown-menu
                                            ul.items
                                                li
                                                    a.active(href="" data-value="my")
                                                        span Mỹ
                                                li
                                                    a(href="" data-value="canada")
                                                        span Canada
                                                li
                                                    a(href="" data-value="uc")
                                                        span Úc
                                                li
                                                    a(href="" data-value="anh")
                                                        span Anh
                                                li
                                                    a(href="" data-value="duc")
                                                        span Đức
                                            //- Có check chọn show nút reset
                                            button.btn.btn-reset.d-none(type="button") Bỏ chọn

                                    .rt-school__banner--form__field.dropdown
                                        button.btn.dropdown-toggle(type="button" data-bs-toggle="dropdown" data-label="Chọn Tỉnh bang/Thành phố") Chọn Tỉnh bang/Thành phố
                                        .dropdown-menu
                                            //- Trên 8 items hiện khung search
                                            .rt-school__banner--form__field--search
                                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                                                    <g opacity="0.5">
                                                        <path d="M21.354 20.646L17.345 16.637C18.681 15.135 19.501 13.164 19.501 11C19.501 6.313 15.688 2.5 11.001 2.5C6.31398 2.5 2.50098 6.313 2.50098 11C2.50098 15.687 6.31398 19.5 11.001 19.5C13.165 19.5 15.136 18.68 16.638 17.344L20.647 21.353C20.745 21.451 20.873 21.499 21.001 21.499C21.129 21.499 21.257 21.45 21.355 21.353C21.549 21.158 21.549 20.842 21.354 20.646ZM3.5 11C3.5 6.865 6.864 3.5 11 3.5C15.136 3.5 18.5 6.865 18.5 11C18.5 15.135 15.136 18.5 11 18.5C6.864 18.5 3.5 15.135 3.5 11Z" fill="white"/>
                                                    </g>
                                                </svg>
                                                input.tax-search(type="text" placeholder="Tìm kiếm...")
                                            ul.items
                                                li
                                                    label
                                                        input(type="radio" name="province" value="alabama")
                                                        span Alabama
                                                li
                                                    label
                                                        input(type="radio" name="province" value="alaska")
                                                        span Alaska
                                                li
                                                    label
                                                        input(type="radio" name="province" value="arizona")
