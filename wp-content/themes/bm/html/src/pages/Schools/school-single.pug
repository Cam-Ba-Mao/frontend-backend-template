extends ../../_core/layouts/layouts-default

append vars
    -bodyClass = "single-school is-transparent"
    -typeMenu = ""

block container
    
    section.rt-school__banner
                .container
                    .row
                        .col-lg-8
                            a.rt-school__feature.rt-light-gallery(href="#" data-sources=`[{ "src": "https://www.youtube.com/watch?v=Zv11L-ZfrSg",  "thumb" : "./images/schools/post1-image.png", "subHtml" : "" }]`)
