                                    img.school-img.lazy(data-src="./images/schools/post1-image.png" alt="")
                                    img.school-logo.lazy(data-src="./images/schools/post1-small.svg" alt="")
                                button.post-video.btn-play(type="button")

                            ul.rt-school__metadata
                                li
                                    img.rt-school__metadata--image.lazy(data-src="./images/schools/globe-earth.svg" alt="globe-earth")
