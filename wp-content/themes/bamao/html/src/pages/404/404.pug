extends ../../_core/layouts/layouts-default

append vars
    -bodyClass = "error404 page-template-404 is-transparent"

block container

    section.bm-error
        .container
            .bm-error__wrap
                .bm-error__image
                    img(src="./images/404/404.svg", alt="alt")
                .bm-error__title.gobs-title PAGE NOT FOUND
                .bm-error__desc We’re sorry, the page you requested could not be found.<br> Please go back to the previous page!
                .bm-error__cta 
                    a(href="#" class="bm-btn btn-primary") Previous Page